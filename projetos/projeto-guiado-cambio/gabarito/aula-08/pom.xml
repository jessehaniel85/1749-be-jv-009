<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.9</version>
    <relativePath/>
  </parent>

  <groupId>br.com.ada.cambio</groupId>
  <artifactId>cambio-aula-08</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Cambio :: Aula 08 :: Design Patterns</name>
  <description>Strategy por moeda, Facade de cambio, Singleton, Adapter nomeado e Builder.</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Trem do Spring Cloud compativel com Spring Boot 3.5.x -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>

  <modules>
    <module>discovery-server</module>
    <module>cliente-service</module>
    <module>cotacao-service</module>
    <module>cambio-service</module>
  </modules>

  <!--
    O BOM do Spring Cloud NAO fixa versao de dependencia por si: ele so diz
    "se voce usar este artefato, use ESTA versao". Por isso os modulos declaram
    os starters sem <version>.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
